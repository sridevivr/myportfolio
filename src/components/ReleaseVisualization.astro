type ReleaseItem = { v: string; url: string | null };
type ReleaseGroup = { lbl: string; items: ReleaseItem[] };
type Lane = {
  id: string;
  label: string;
  sublabel: string;
  fullName: string;
  color: string;
  glow: string;
  groups: ReleaseGroup[];
};

