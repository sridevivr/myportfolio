<section class="px-6 md:px-10 pt-16 md:pt-24 pb-8 md:pb-12">
  <div class="mx-auto w-full max-w-6xl">
    <div class="hero-grid">

      <!-- HEADING area: kicker, name, subtitle, badge -->
      <div class="hero-area-heading flex flex-col">
        <p class="font-mono text-sm text-ink-muted dark:text-neutral-400 mb-3">
          Hi! :)
        </p>

        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">
          Sridevi Vijayaraghavan
        </h1>

        <p class="mt-5 text-lg md:text-xl text-ink dark:text-neutral-100 font-medium">
          You can call me Sri, or Devi (they-vee). I'm really curious about tech, and more recently AI.
        </p>

        <div class="mt-5 inline-flex self-start items-center gap-2.5 rounded-full bg-accent-subtle dark:bg-indigo-950/40 border border-accent/20 dark:border-indigo-800/40 px-4 py-2 text-sm font-medium text-accent dark:text-indigo-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          Open to operations roles in Business, Product, Strategy and AI
        </div>
      </div>

      <!-- PHOTO area: one element, reflows across breakpoints via grid-area -->
      <div class="hero-area-photo">
        <div class="photo-frame relative overflow-hidden rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900">
          <img
            src="/me.jpeg"
            alt="Sridevi Vijayaraghavan"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <!-- BODY: intro paragraph + recent builds -->
      <div class="hero-area-body max-w-2xl space-y-4 text-[1.05rem] leading-relaxed text-ink-muted dark:text-neutral-300">
        <p>
          I'm an ex-VMware Technical Program Manager and Dartmouth MBA focused on Product Ops, Business Ops, and AI strategy roles. I use AI tools to build research systems, dashboards, and product experiments.
        </p>
        <div class="pt-2">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-subtle dark:text-neutral-500 mb-2">
            Recent builds
          </p>
          <ul class="space-y-1.5 text-[0.95rem]">
            <li class="flex gap-2">
              <span class="text-ink-subtle dark:text-neutral-500 shrink-0">→</span>
              <span>Wayfarer, a walking app that turns daily steps into AI-narrated journeys</span>
            </li>
            <li class="flex gap-2">
              <span class="text-ink-subtle dark:text-neutral-500 shrink-0">→</span>
              <span>SaaS pricing intelligence dashboard</span>
            </li>
            <li class="flex gap-2">
              <span class="text-ink-subtle dark:text-neutral-500 shrink-0">→</span>
              <span>Cursor inference cost-chain analysis</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ----------------------------------------------------------------------
     Base (mobile + tablet, <lg): single column.
     HTML order stays the same; grid-template-areas places the photo
     between heading and body.
     ---------------------------------------------------------------------- */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "heading"
      "photo"
      "body";
  }

  .hero-area-heading { grid-area: heading; }
  .hero-area-photo   { grid-area: photo;   }
  .hero-area-body    { grid-area: body;    }

  /* Vertical rhythm between the three areas in single-column mode */
  .hero-area-photo { margin-top: 1.75rem; }
  .hero-area-body  { margin-top: 1.5rem;  }

  /* Photo frame, single-column (phone + tablet):
     Use a short, landscape-ish aspect so the photo doesn't dominate the
     viewport and push body copy below the fold. object-position crops
     from the bottom, keeping the face in frame, swap aspect + crop
     position at narrower widths instead of keeping portrait everywhere. */
  .photo-frame {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 4 / 3;      /* taller than 3/2, shows face + shoulders */
    margin-left: auto;
    margin-right: auto;
  }
  .photo-frame img {
    object-fit: cover;
    object-position: center 40%;  /* keep face, but show more torso than before */
  }

  /* Slightly taller photo on small tablets for a bit more presence */
  @media (min-width: 640px) {
    .photo-frame {
      aspect-ratio: 4 / 3;
      max-width: 680px;
      max-height: 520px;
    }
  }

  /* ----------------------------------------------------------------------
     Desktop (≥lg, 1024px+): two columns.
     Photo spans both rows on the LEFT; text column stacks on the RIGHT.
     ---------------------------------------------------------------------- */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: auto 1fr;
      column-gap: 3.5rem;
      grid-template-areas:
        "photo heading"
        "photo body";
    }

    /* Reset the single-column spacing that we added above. */
    .hero-area-photo { margin-top: 3.5rem; align-self: start; }
    .hero-area-body  { margin-top: 2rem;   }

    /* Photo becomes fixed-size portrait at desktop, full frame */
    .photo-frame {
      width: 410px;
      max-width: none;
      max-height: none;
      height: 570px;
      aspect-ratio: auto;
      margin-left: 0;
      margin-right: 0;
    }
    .photo-frame img {
      object-position: center center;  /* restore full portrait framing */
    }
  }

  /* Slightly larger photo at xl+ for big monitors (optional polish) */
  @media (min-width: 1280px) {
    .photo-frame {
      width: 440px;
      height: 610px;
    }
  }
</style>
