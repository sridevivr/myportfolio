---
// Nav — sticky top navigation. Smooth-scroll handled globally by
// `html { scroll-behavior: smooth }` in global.css; no JS needed.
---

<nav class="sticky top-0 z-50 border-b border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur-sm">
  <div class="mx-auto max-w-content px-6 py-4 flex items-center justify-center">
    <div class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm">
      <a href="#about" class="text-ink-muted dark:text-neutral-400 hover:text-ink dark:hover:text-neutral-100 transition">About</a>
      <a href="#career" class="text-ink-muted dark:text-neutral-400 hover:text-ink dark:hover:text-neutral-100 transition">Career</a>
      <a href="#projects" class="text-ink-muted dark:text-neutral-400 hover:text-ink dark:hover:text-neutral-100 transition">Projects</a>
      <a href="#contact" class="text-ink-muted dark:text-neutral-400 hover:text-ink dark:hover:text-neutral-100 transition">Get in touch</a>
    </div>
  </div>
</nav>
