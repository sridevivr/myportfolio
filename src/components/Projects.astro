---
import { projects } from '~/data/projects';
import ProjectCard from './ProjectCard.astro';

const products = projects.filter((p) => p.category === 'product');
const business = projects.filter((p) => p.category === 'business');
---

<section id="projects" class="section-anchor">
  <div class="mx-auto max-w-content px-6 py-10 md:py-14">
    <p class="kicker mb-4">Projects</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
      Things I've built with AI tools
    </h2>

    {products.length > 0 && (
      <div class="mt-12">
        <p class="font-mono text-sm uppercase tracking-[0.14em] text-ink-muted dark:text-neutral-400 mb-2">
          Product
        </p>
        <div>
          {products.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    )}

    {business.length > 0 && (
      <div class="mt-16">
        <p class="font-mono text-sm uppercase tracking-[0.14em] text-ink-muted dark:text-neutral-400 mb-2">
          Business tools
        </p>
        <div>
          {business.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    )}
  </div>
</section>
